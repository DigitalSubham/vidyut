name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  ci:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: vidyut
          POSTGRES_PASSWORD: vidyut
          POSTGRES_DB: vidyut_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U vidyut"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    env:
      DATABASE_URL: postgresql://vidyut_app:vidyut_app@localhost:5432/vidyut_test?schema=public
      TEST_DATABASE_URL: postgresql://vidyut_app:vidyut_app@localhost:5432/vidyut_test?schema=public
      REDIS_URL: redis://localhost:6379
      JWT_ACCESS_SECRET: ci-test-access-secret
      JWT_REFRESH_SECRET: ci-test-refresh-secret
      JWT_PLATFORM_SECRET: ci-test-platform-secret
      RAZORPAY_WEBHOOK_SECRET: ci-test-razorpay-secret
      NODE_ENV: test

    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 11

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Create vidyut_app role (mirrors docker/postgres-init)
        run: |
          PGPASSWORD=vidyut psql -h localhost -U vidyut -d postgres -c \
            "CREATE ROLE vidyut_app WITH LOGIN PASSWORD 'vidyut_app' NOSUPERUSER NOBYPASSRLS CREATEDB;"
          PGPASSWORD=vidyut psql -h localhost -U vidyut -d postgres -c \
            "ALTER DATABASE vidyut_test OWNER TO vidyut_app;"

      - name: Run migrations
        run: pnpm --filter @vidyut/db exec prisma migrate deploy --schema prisma/schema
        env:
          DATABASE_URL: postgresql://vidyut_app:vidyut_app@localhost:5432/vidyut_test?schema=public

      - name: Lint
        run: pnpm run lint

      - name: Typecheck
        run: pnpm run typecheck

      - name: Test (includes Unit 34's isolation/RBAC static checks)
        run: pnpm --filter @vidyut/api test

      - name: Build
        run: pnpm run build
