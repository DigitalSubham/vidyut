DATABASE_URL="postgresql://vidyut_app:vidyut_app@localhost:5432/vidyut?schema=public"
REDIS_URL="redis://localhost:6379"
TEST_REDIS_URL="redis://localhost:6379/1"

# Object storage (local MinIO from docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="vidyut-dev"
S3_ACCESS_KEY_ID="vidyut"
S3_SECRET_ACCESS_KEY="vidyut12345"
S3_FORCE_PATH_STYLE="true"

# Notification providers — optional in dev; unset means the provider no-ops.
# MSG91_API_KEY=""
# MSG91_SENDER_ID=""
# GUPSHUP_API_KEY=""
# GUPSHUP_SOURCE_NUMBER=""
# FCM_SERVER_KEY=""
# SES_FROM_ADDRESS=""
# SES_REGION="ap-south-1"
# SMS_COST_PAISE="20"

# E-sign + EAS app builds — optional in dev.
# ESIGN_PROVIDER_URL=""
# ESIGN_API_KEY=""
# EAS_PROJECT_ID=""
# EAS_ROBOT_ACCESS_TOKEN=""

# SENTRY_DSN=""
