// Tenancy foundation — Unit 02. See context/data-model.md §2 and
// context/architecture-context.md §3 for the RLS + withTenant() model this depends on.

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum AppDelivery {
  SHARED
  DEDICATED
}

enum Board {
  CBSE
  ICSE
  STATE_BIHAR
  OTHER
}

/// The customer (school owner/group). Platform-level — not itself RLS-scoped;
/// accessed by the super-admin surface, not through withTenant().
model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  // Unit 15b addition — short, human-friendly code the mobile app resolves
  // to a tenant (replaces typing `tenantSlug` by hand). Nullable so existing
  // rows can be backfilled by migration; every new tenant gets one at creation.
  schoolCode String?      @unique
  status     TenantStatus @default(TRIAL)
  planId    String?
  appType   AppDelivery  @default(SHARED)
  locale    String       @default("en")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  plan Plan? @relation(fields: [planId], references: [id])

  branches          Branch[]
  academicSessions  AcademicSession[]
  users             User[]
  roles             Role[]
  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  branchMemberships BranchMembership[]
  refreshTokens     RefreshToken[]
  subscriptions     Subscription[]
  moduleToggles     ModuleToggle[]
  platformInvoices  PlatformInvoice[]
  smsWallet         SmsWallet?
  appBuilds         AppBuild[]
  auditLogs         AuditLog[]
  classes           Class[]
  sections          Section[]
  subjects          Subject[]
  classSubjects     ClassSubject[]
  teacherAssignments TeacherAssignment[]
  students          Student[]
  enrollments       Enrollment[]
  guardians         Guardian[]
  studentGuardians  StudentGuardian[]
  staff             Staff[]
  leaveRequests     LeaveRequest[]
  enquiries         Enquiry[]
  applications      Application[]
  feeHeads          FeeHead[]
  feeStructures     FeeStructure[]
  feeStructureItems FeeStructureItem[]
  fineRules         FineRule[]
  feeAssignments    FeeAssignment[]
  concessions       Concession[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  payments          Payment[]
  receipts          Receipt[]
  refundRequests    RefundRequest[]
  notificationLogs  NotificationLog[]
  announcements     Announcement[]
  certificates      Certificate[]
  timetablePeriods  TimetablePeriod[]
  homework          Homework[]
  walletTxns        WalletTxn[]
  attendanceRecords AttendanceRecord[]
  exams             Exam[]
  examSubjects      ExamSubject[]
  marksEntries      MarksEntry[]
  reportCardTemplates ReportCardTemplate[]
  reportCards       ReportCard[]
}

/// A physical school under the tenant. Tenant-owned — RLS-scoped.
model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  board     Board     @default(CBSE)
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  academicSessions  AcademicSession[]
  userRoles         UserRole[]
  branchMemberships BranchMembership[]
  classes           Class[]
  sections          Section[]
  subjects          Subject[]
  teacherAssignments TeacherAssignment[]
  students          Student[]
  enrollments       Enrollment[]
  staff             Staff[]
  leaveRequests     LeaveRequest[]
  enquiries         Enquiry[]
  applications      Application[]
  feeHeads          FeeHead[]
  feeStructures     FeeStructure[]
  fineRules         FineRule[]
  feeAssignments    FeeAssignment[]
  concessions       Concession[]
  invoices          Invoice[]
  payments          Payment[]
  receipts          Receipt[]
  refundRequests    RefundRequest[]
  notificationLogs  NotificationLog[]
  announcements     Announcement[]
  certificates      Certificate[]
  timetablePeriods  TimetablePeriod[]
  homework          Homework[]
  attendanceRecords AttendanceRecord[]
  exams             Exam[]
  marksEntries      MarksEntry[]
  reportCardTemplates ReportCardTemplate[]
  reportCards       ReportCard[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// An academic year for a branch, e.g. "2026-27". Tenant-owned — RLS-scoped.
model AcademicSession {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  attendanceRecords  AttendanceRecord[]
  exams              Exam[]
  reportCards        ReportCard[]
  timetablePeriods   TimetablePeriod[]

  @@unique([branchId, name])
  @@index([tenantId])
}
