// Tenancy foundation — Unit 02. See context/data-model.md §2 and
// context/architecture-context.md §3 for the RLS + withTenant() model this depends on.

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum AppDelivery {
  SHARED
  DEDICATED
}

enum Board {
  CBSE
  ICSE
  STATE_BIHAR
  OTHER
}

/// The customer (school owner/group). Platform-level — not itself RLS-scoped;
/// accessed by the super-admin surface, not through withTenant().
model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  // Unit 15b addition — short, human-friendly code the mobile app resolves
  // to a tenant (replaces typing `tenantSlug` by hand). Nullable so existing
  // rows can be backfilled by migration; every new tenant gets one at creation.
  schoolCode String?      @unique
  status     TenantStatus @default(TRIAL)
  planId    String?
  appType   AppDelivery  @default(SHARED)
  locale    String       @default("en")
  // Unit 36 — school-group-level profile (settings.manage). Per-branch
  // address/board/logo already exist on Branch; these are the group-wide
  // defaults shown on the tenant's own "Settings" screen.
  address           String?
  logoUrl           String?
  // Unit 69 scope #7 — the missing super-admin UI to actually set the
  // white-label parameters Unit 31's app-config pipeline already reads.
  primaryColor      String?
  customDomain      String?
  admissionNoPrefix String?
  invoiceNoPrefix   String?
  // Unit 54 — public-site contact section (TenantContactInfo, kept as flat
  // fields on Tenant, same convention as the group profile fields above).
  contactPhone      String?
  contactEmail      String?
  mapUrl            String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  plan Plan? @relation(fields: [planId], references: [id])

  branches          Branch[]
  academicSessions  AcademicSession[]
  users             User[]
  roles             Role[]
  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  branchMemberships BranchMembership[]
  refreshTokens     RefreshToken[]
  subscriptions     Subscription[]
  moduleToggles     ModuleToggle[]
  platformInvoices  PlatformInvoice[]
  smsWallet         SmsWallet?
  appBuilds         AppBuild[]
  auditLogs         AuditLog[]
  classes           Class[]
  sections          Section[]
  subjects          Subject[]
  classSubjects     ClassSubject[]
  teacherAssignments TeacherAssignment[]
  students          Student[]
  enrollments       Enrollment[]
  guardians         Guardian[]
  studentGuardians  StudentGuardian[]
  staff             Staff[]
  leaveRequests     LeaveRequest[]
  enquiries         Enquiry[]
  applications      Application[]
  feeHeads          FeeHead[]
  feeStructures     FeeStructure[]
  feeStructureItems FeeStructureItem[]
  fineRules         FineRule[]
  feeAssignments    FeeAssignment[]
  concessions       Concession[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  payments          Payment[]
  receipts          Receipt[]
  refundRequests    RefundRequest[]
  chequePayments    ChequePayment[]
  notificationLogs  NotificationLog[]
  announcements     Announcement[]
  certificates      Certificate[]
  timetablePeriods  TimetablePeriod[]
  homework          Homework[]
  homeworkSubmissions HomeworkSubmission[]
  walletTxns        WalletTxn[]
  attendanceRecords AttendanceRecord[]
  staffAttendanceRecords StaffAttendanceRecord[]
  exams             Exam[]
  examSubjects      ExamSubject[]
  marksEntries      MarksEntry[]
  reportCardTemplates ReportCardTemplate[]
  reportCards       ReportCard[]
  examTimetables    ExamTimetable[]
  coScholasticGrades CoScholasticGrade[]
  questionBankItems QuestionBankItem[]
  onlineExams       OnlineExam[]
  onlineExamQuestions OnlineExamQuestion[]
  onlineExamSubmissions OnlineExamSubmission[]
  dataDeletionRequests DataDeletionRequest[]
  notificationTemplates NotificationTemplate[]
  electiveGroups        ElectiveGroup[]
  studentElectiveChoices StudentElectiveChoice[]
  houses                House[]
  substitutions         Substitution[]
  circulars             Circular[]
  circularAcks          CircularAck[]
  ptmSlots              PTMSlot[]
  calendarEvents        CalendarEvent[]
  complaints            Complaint[]
  surveys               Survey[]
  surveyQuestions       SurveyQuestion[]
  surveyResponses       SurveyResponse[]
  galleryAlbums         GalleryAlbum[]
  galleryPhotos         GalleryPhoto[]
  messages              Message[]
  certificateTemplates  CertificateTemplate[]
  documents             Document[]
  publicNotices         PublicNotice[]
  supportTickets        SupportTicket[]
  routes                Route[]
  routeStops            RouteStop[]
  vehicles              Vehicle[]
  transportDrivers      Driver[]
  routeAllocations      StudentRouteAllocation[]
  locationPings         LocationPing[]
  books                 Book[]
  bookCopies            BookCopy[]
  libraryMembers        LibraryMember[]
  bookIssues            BookIssue[]
  hostelBlocks          HostelBlock[]
  rooms                 Room[]
  roomAllocations       RoomAllocation[]
  hostelAttendanceRecords HostelAttendanceRecord[]
  visitors              Visitor[]
  gatePasses            GatePass[]
  complaintDeskEntries  ComplaintDeskEntry[]
  callLogEntries        CallLogEntry[]
  postalLogEntries      PostalLogEntry[]
  healthRecords         HealthRecord[]
  disciplineIncidents   DisciplineIncident[]
  awards                Award[]
  canteenWallets        CanteenWallet[]
  canteenTxns           CanteenTxn[]
  lostFoundEntries      LostFoundEntry[]
  expenseHeads          ExpenseHead[]
  expenses              Expense[]
  salaryStructures      SalaryStructure[]
  siblingGroups         SiblingGroup[]
  studentTimelineEntries StudentTimelineEntry[]
  stores                Store[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  grns                  Grn[]
  grnLines              GrnLine[]
  assets                Asset[]
  storeItems            StoreItem[]
  storeOrders           StoreOrder[]
  staffTasks            StaffTask[]
  syllabusChapters      SyllabusChapter[]
  lessonPlans           LessonPlan[]
  contentItems          ContentItem[]
  liveClassLinks        LiveClassLink[]
  communicationPreferences CommunicationPreference[]
  newsletters           Newsletter[]
}

/// A physical school under the tenant. Tenant-owned — RLS-scoped.
model Branch {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  board     Board     @default(CBSE)
  logoUrl   String?
  isActive  Boolean   @default(true)
  /// Unit 44 device-scan ingestion — a biometric/RFID device authenticates
  /// with this token instead of a user JWT (a device isn't a user).
  attendanceDeviceToken String? @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  academicSessions  AcademicSession[]
  userRoles         UserRole[]
  branchMemberships BranchMembership[]
  classes           Class[]
  sections          Section[]
  subjects          Subject[]
  teacherAssignments TeacherAssignment[]
  students          Student[]
  enrollments       Enrollment[]
  staff             Staff[]
  leaveRequests     LeaveRequest[]
  enquiries         Enquiry[]
  applications      Application[]
  feeHeads          FeeHead[]
  feeStructures     FeeStructure[]
  fineRules         FineRule[]
  feeAssignments    FeeAssignment[]
  concessions       Concession[]
  invoices          Invoice[]
  payments          Payment[]
  receipts          Receipt[]
  refundRequests    RefundRequest[]
  notificationLogs  NotificationLog[]
  announcements     Announcement[]
  certificates      Certificate[]
  timetablePeriods  TimetablePeriod[]
  homework          Homework[]
  attendanceRecords AttendanceRecord[]
  staffAttendanceRecords StaffAttendanceRecord[]
  exams             Exam[]
  marksEntries      MarksEntry[]
  reportCardTemplates ReportCardTemplate[]
  reportCards       ReportCard[]
  electiveGroups        ElectiveGroup[]
  studentElectiveChoices StudentElectiveChoice[]
  houses                House[]
  coScholasticGrades    CoScholasticGrade[]
  questionBankItems     QuestionBankItem[]
  onlineExams           OnlineExam[]
  substitutions         Substitution[]
  circulars             Circular[]
  ptmSlots              PTMSlot[]
  calendarEvents        CalendarEvent[]
  complaints            Complaint[]
  surveys               Survey[]
  galleryAlbums         GalleryAlbum[]
  messages              Message[]
  certificateTemplates  CertificateTemplate[]
  documents             Document[]
  publicNotices         PublicNotice[]
  routes                Route[]
  vehicles              Vehicle[]
  transportDrivers      Driver[]
  routeAllocations      StudentRouteAllocation[]
  books                 Book[]
  bookCopies            BookCopy[]
  libraryMembers        LibraryMember[]
  bookIssues            BookIssue[]
  hostelBlocks          HostelBlock[]
  rooms                 Room[]
  roomAllocations       RoomAllocation[]
  hostelAttendanceRecords HostelAttendanceRecord[]
  visitors              Visitor[]
  gatePasses            GatePass[]
  complaintDeskEntries  ComplaintDeskEntry[]
  callLogEntries        CallLogEntry[]
  postalLogEntries      PostalLogEntry[]
  healthRecords         HealthRecord[]
  disciplineIncidents   DisciplineIncident[]
  awards                Award[]
  canteenWallets        CanteenWallet[]
  canteenTxns           CanteenTxn[]
  lostFoundEntries      LostFoundEntry[]
  expenseHeads          ExpenseHead[]
  expenses              Expense[]
  salaryStructures      SalaryStructure[]
  studentTimelineEntries StudentTimelineEntry[]
  stores                Store[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  grns                  Grn[]
  assets                Asset[]
  storeItems            StoreItem[]
  storeOrders           StoreOrder[]
  staffTasks            StaffTask[]
  syllabusChapters      SyllabusChapter[]
  lessonPlans           LessonPlan[]
  contentItems          ContentItem[]
  liveClassLinks        LiveClassLink[]
  newsletters           Newsletter[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// An academic year for a branch, e.g. "2026-27". Tenant-owned — RLS-scoped.
model AcademicSession {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  attendanceRecords  AttendanceRecord[]
  exams              Exam[]
  reportCards        ReportCard[]
  timetablePeriods   TimetablePeriod[]

  @@unique([branchId, name])
  @@index([tenantId])
}
