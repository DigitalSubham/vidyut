// Homework/Assignments — Unit 23. See context/data-model.md §11 and
// context/feature-specs/23-homework-assignments.md. Last unit of Milestone
// 6 — closes out the backend-core CRUD build (Milestone 7 onward is
// apps/dashboards/billing/hardening, not new domain models).

/// A homework/assignment notice for a section+subject. Tenant-owned — RLS-scoped.
model Homework {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  sectionId     String
  subjectId     String
  title         String
  description   String
  attachmentUrl String?
  dueDate       DateTime
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])
  section     Section              @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  submissions HomeworkSubmission[]

  @@index([tenantId])
}

/// Unit 45 — a student's submission against one Homework. Grading (`grade`/
/// `feedback`) is deliberately separate from `MarksEntry` (exam marks) — a
/// different concept the spec explicitly says not to conflate. Tenant-owned
/// — RLS-scoped.
model HomeworkSubmission {
  id           String    @id @default(cuid())
  tenantId     String
  homeworkId   String
  studentId    String
  fileUrl      String
  submittedAt  DateTime  @default(now())
  grade        String?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([tenantId])
}
