// Attendance — Unit 15. See context/data-model.md §8 and
// context/feature-specs/15-attendance.md.

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
  HOLIDAY
}

enum AttendanceSource {
  APP
  WEB
  BIOMETRIC
  IMPORT
}

/// One student's attendance for one day. `id` may be client-supplied (Unit
/// 16's offline mobile sync uses this for idempotent upsert) or server-
/// generated. `regularizedById`/`regularizeReason` are a small addition
/// beyond data-model.md's sketch — needed to audit the correction path
/// (context/feature-specs/15's scope #4). Branch-owned — RLS-scoped.
model AttendanceRecord {
  id           String           @id @default(cuid())
  tenantId     String
  branchId     String
  sessionId    String
  sectionId    String
  studentId    String
  date         DateTime
  status       AttendanceStatus
  markedById   String
  source       AttendanceSource @default(WEB)
  regularizedById String?
  regularizeReason String?
  syncedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])
  section Section         @relation(fields: [sectionId], references: [id])
  student Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([tenantId])
}
