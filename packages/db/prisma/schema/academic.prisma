// Academic structure — Unit 06. See context/data-model.md §4 and
// context/feature-specs/06-academic-structure.md.

enum SubjectType {
  CORE
  ELECTIVE
  CO_SCHOLASTIC
  PRACTICAL
}

/// A grade, e.g. "Class 8". Tenant-owned — RLS-scoped.
model Class {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  sections     Section[]
  classSubjects ClassSubject[]
  enrollments  Enrollment[]
  applications Application[]
  feeStructures FeeStructure[]
  examSubjects ExamSubject[]
  electiveGroups ElectiveGroup[]
  onlineExams OnlineExam[]
  questionBankItems QuestionBankItem[]

  @@unique([branchId, name])
  @@index([tenantId])
}

/// A section within a class, e.g. "8-A". Tenant-owned — RLS-scoped.
model Section {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  classId        String
  name           String
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  branch       Branch @relation(fields: [branchId], references: [id])
  class        Class  @relation(fields: [classId], references: [id])
  classTeacher Staff? @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])

  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  timetablePeriods   TimetablePeriod[]
  homework           Homework[]

  @@unique([classId, name])
  @@index([tenantId])
}

/// A branch-level subject catalog entry (not per-class). Tenant-owned — RLS-scoped.
model Subject {
  id        String      @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  type      SubjectType @default(CORE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  classSubjects ClassSubject[]
  teacherAssignments TeacherAssignment[]
  examSubjects  ExamSubject[]
  timetablePeriods TimetablePeriod[]
  homework      Homework[]
  examTimetables ExamTimetable[]
  onlineExams   OnlineExam[]
  questionBankItems QuestionBankItem[]

  @@unique([branchId, code])
  @@index([tenantId])
}

/// Which subjects are offered in a class. Tenant-owned — RLS-scoped.
model ClassSubject {
  id         String   @id @default(cuid())
  tenantId   String
  classId    String
  subjectId  String
  isElective Boolean  @default(false)
  // Unit 43 — an elective ClassSubject optionally belongs to one named
  // basket a student picks from; null for a required (non-elective) subject.
  electiveGroupId String?
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  electiveGroup ElectiveGroup? @relation(fields: [electiveGroupId], references: [id])
  studentChoices StudentElectiveChoice[]

  @@unique([classId, subjectId])
  @@index([tenantId])
}

/// Unit 43 — a named set of elective `ClassSubject` rows a student picks
/// one from (e.g. "XI Elective Basket A": Biology/Computer Science/
/// Psychology). Tenant-owned — RLS-scoped.
model ElectiveGroup {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  classId   String
  name      String
  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  class    Class          @relation(fields: [classId], references: [id])
  options  ClassSubject[]
  choices  StudentElectiveChoice[]

  @@index([tenantId])
}

/// Unit 43 — a student's pick from one `ElectiveGroup`, one per group.
/// Tenant-owned — RLS-scoped.
model StudentElectiveChoice {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  studentId       String
  electiveGroupId String
  classSubjectId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  electiveGroup ElectiveGroup @relation(fields: [electiveGroupId], references: [id])
  classSubject  ClassSubject  @relation(fields: [classSubjectId], references: [id])

  @@unique([studentId, electiveGroupId])
  @@index([tenantId])
}

/// Unit 43 — simple house tagging for events/discipline points; no scoring
/// engine (D6 Discipline module territory). Tenant-owned — RLS-scoped.
model House {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  students Student[]

  @@unique([branchId, name])
  @@index([tenantId])
}

/// Teacher <-> subject <-> section mapping for a session. Unit 06 shipped
/// this schema-only; Unit 09 adds the staffId relation (now that Staff
/// exists) and the write endpoints. Tenant-owned — RLS-scoped.
model TeacherAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  sessionId String
  staffId   String
  subjectId String
  sectionId String
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])
  staff   Staff           @relation(fields: [staffId], references: [id])
  subject Subject         @relation(fields: [subjectId], references: [id])
  section Section         @relation(fields: [sectionId], references: [id])

  @@unique([sessionId, staffId, subjectId, sectionId])
  @@index([tenantId])
}
