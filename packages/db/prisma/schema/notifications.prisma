// Fee reminders / notification log — Unit 14. See context/data-model.md
// §11, §13 and context/feature-specs/14-fee-reminders.md.

enum NotifChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotifStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

/// A record of a notification attempt (fee reminder now; Unit 20 reuses this
/// for general-purpose announcements). Branch-owned — RLS-scoped.
model NotificationLog {
  id          String       @id @default(cuid())
  tenantId    String
  branchId    String
  channel     NotifChannel
  templateKey String
  toUserId    String?
  toPhone     String?
  status      NotifStatus  @default(QUEUED)
  payload     Json?
  sentAt      DateTime?
  // Unit 40 — the in-app inbox's read/unread state.
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

/// Unit 40 — a lookup the real send functions consult instead of hardcoded
/// strings. `dltId` records a DLT-approved template ID once the user has
/// registered one with their SMS/WhatsApp operator (India's TRAI DLT regime
/// — a legal/telecom process this repo can't self-certify, per this unit's
/// own Open Question 2); null until then. Branch-less (a tenant-wide
/// registry, not per-branch) — tenant-owned, RLS-scoped.
model NotificationTemplate {
  id          String       @id @default(cuid())
  tenantId    String
  templateKey String
  channel     NotifChannel
  dltId       String?
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, templateKey, channel])
  @@index([tenantId])
}

/// A notice-board record — Unit 20. See context/data-model.md §11 and
/// context/feature-specs/20-notifications-announcements.md. `audience` is a
/// simple rule object `{ roles?: RoleKey[], classIds?: string[] }`, not a
/// query engine (Open Question 1) — empty/omitted means "everyone in the
/// branch." `createdById` is a small addition beyond the bare doc sketch
/// (the issuer, needed for the register), same convention as Unit 15's
/// `regularizedById`. Publishes immediately on create (no draft state).
/// Branch-owned — RLS-scoped.
model Announcement {
  id            String    @id @default(cuid())
  tenantId      String
  branchId      String
  title         String
  body          String
  audience      Json?
  attachmentUrl String?
  publishedAt   DateTime  @default(now())
  createdById   String
  createdAt     DateTime  @default(now())
  // Unit 40 — a one-off future send time; if set, fan-out is enqueued with a
  // BullMQ delay instead of running immediately (Open Question 4).
  scheduledFor  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

/// context/feature-specs/14's Open Questions — data-model.md §13 gave this
/// model with its fields literally elided. No RLS, same as SmsWallet (Unit
/// 05's decision: platform-managed config, plain tenantId-filtered queries).
model WalletTxn {
  id          String        @id @default(cuid())
  tenantId    String
  type        WalletTxnType
  amount      Int
  reason      String
  referenceId String?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}
