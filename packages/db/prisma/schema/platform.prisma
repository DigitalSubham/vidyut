// Platform / super-admin — Unit 05. See context/data-model.md §13 and
// context/plans-entitlements.md for the plan/module/limit rules.
//
// RLS note: unlike §2-12, these tables (except AuditLog) do NOT have RLS.
// data-model.md §13 labels this whole section "NOT tenant-scoped" even
// though most rows carry a tenantId column (kept for indexing/filtering,
// not for RLS) — they are platform-managed configuration consulted by
// internal guards and the super-admin surface, never a tenant-facing CRUD
// resource. Application code is responsible for scoping these queries by
// tenantId; there is no RLS safety net here, unlike every other table.

enum PlanKey {
  STARTER
  STANDARD
  PRO
  ENTERPRISE
}

enum ModuleKey {
  students
  attendance
  fees
  communication
  parent_app
  teacher_app
  exams_reportcards
  admissions
  certificates
  timetable
  homework
  online_payment
  owner_dashboard
  staff_leave
  multi_branch
  payroll
  transport
  analytics_advanced
  dedicated_app
  library
  hostel
  inventory
  accounting
  ai_features
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AppBuildPlatform {
  ANDROID
  IOS
}

enum AppBuildStoreStatus {
  PENDING
  BUILDING
  SUBMITTED
  LIVE
  FAILED
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

/// Global plan catalog — not tenant-owned at all (no tenantId column).
model Plan {
  id           String      @id @default(cuid())
  key          PlanKey     @unique
  name         String
  priceYear    Int
  setupFee     Int
  studentLimit Int?
  userLimit    Int?
  branchLimit  Int?
  storageGb    Int?
  appType      AppDelivery
  modules      Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subscriptions Subscription[]
  tenants       Tenant[]
}

model Subscription {
  id               String             @id @default(cuid())
  tenantId         String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  seats            Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  platformInvoices PlatformInvoice[]

  @@index([tenantId])
}

model ModuleToggle {
  id        String    @id @default(cuid())
  tenantId  String
  moduleKey ModuleKey
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
}

model SmsWallet {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  balancePaise Int      @default(0)
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

/// White-label build pipeline record (real EAS pipeline is Unit 31 — this
/// unit only creates the record + enqueues a stub job).
model AppBuild {
  id          String              @id @default(cuid())
  tenantId    String
  platform    AppBuildPlatform
  mode        AppDelivery
  version     String?
  storeStatus AppBuildStoreStatus @default(PENDING)
  buildRef    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Vidyut's own bill to a school for its subscription (Unit 30). Deliberately
/// named `Platform*` to avoid confusion with the tenant-facing `Invoice`
/// (Unit 12 — fees a school charges *its* parents). Manual create/mark-paid
/// for v1 (context/feature-specs/30-billing-subscriptions.md) — no automated
/// recurring billing engine yet. Platform-managed, no RLS (same posture as
/// Plan/Subscription).
model PlatformInvoice {
  id             String                @id @default(cuid())
  tenantId       String
  subscriptionId String
  invoiceNo      String                @unique
  amount         Int
  status         PlatformInvoiceStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
}

/// Super-admin login — platform-level, no tenantId, no RLS. Separate from
/// User (context/rbac.md: SUPERADMIN operates across tenants, never via
/// withTenant()); a distinct table keeps that invariant structural rather
/// than a convention someone can forget.
model PlatformUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum AuditActorType {
  USER
  PLATFORM_USER
  // Unit 13 addition — webhook-driven mutations (e.g. a Razorpay payment
  // confirmation) have no authenticated human actor.
  SYSTEM
}

/// Sensitive-action trail (context/data-model.md §12). Tenant-owned and
/// RLS-scoped like §2-12 — even platform actions log against the specific
/// tenant they affected, written via withTenant(thatTenantId, ...).
model AuditLog {
  id        String         @id @default(cuid())
  tenantId  String
  branchId  String?
  actorId   String
  actorType AuditActorType @default(USER)
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

/// Unit 69 scope #5 — feedback reuses this model with a `type` tag rather
/// than a parallel model, per the spec's own suggestion.
enum SupportTicketType {
  SUPPORT
  FEEDBACK
}

/// Unit 56, Open Question 1 — a real "SupportTicket" per the spec's own
/// recommendation: create/list/respond, no SLA/escalation engine. Tenant-
/// owned and RLS-scoped like AuditLog above; the platform side reads/writes
/// it the same way — always via withTenant(thatTenantId, ...), never a raw
/// cross-tenant query, and every such read is audit-logged (see
/// `listPlatformTickets`/`respondToTicket` in modules/platform/service.ts).
model SupportTicket {
  id          String                @id @default(cuid())
  tenantId    String
  type        SupportTicketType     @default(SUPPORT)
  subject     String
  body        String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  response    String?
  respondedAt DateTime?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// Unit 56 scope #1 — created by the platform, fanned out (via a background
/// job — AGENTS.md invariant #2, never inline in the request handler) into
/// a real per-tenant `Announcement` row (Unit 20's existing model) for every
/// matching tenant/branch. No tenantId of its own — platform-owned, no RLS,
/// same posture as `Plan` (Unit 05's decision).
model GlobalAnnouncement {
  id             String   @id @default(cuid())
  title          String
  body           String
  targetPlanKeys Json?
  createdById    String
  createdAt      DateTime @default(now())
}
