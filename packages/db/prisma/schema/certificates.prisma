// Certificates & IDs — Unit 21. See context/data-model.md §11 and
// context/feature-specs/21-certificates-ids.md. `ID_CARD`/`ADMIT_CARD` are a
// small, additive extension of data-model.md's bare enum sketch (Open
// Question 1) — an ID/admit card is structurally identical to a certificate,
// just a different `type`.

enum CertificateType {
  TC
  BONAFIDE
  CHARACTER
  CONDUCT
  ID_CARD
  ADMIT_CARD
  CUSTOM
}

/// Unit 50 — e-sign lifecycle on a Certificate. NONE until a signature is
/// requested; REQUESTED while pending the (gated-stub) provider; SIGNED once
/// the provider's webhook confirms it.
enum SignatureStatus {
  NONE
  REQUESTED
  SIGNED
}

/// Unit 50 (Open Question 1) — a reusable, token-based certificate/ID body.
/// `body` is plain-text/simple-HTML containing `{{token}}` placeholders
/// (studentName, className, issueDate, ...), substituted at generation time
/// by `renderCertificateTemplate()` — not a visual designer. `branchId`
/// nullable = tenant-wide default, same convention as `ReportCardTemplate`.
model CertificateTemplate {
  id        String           @id @default(cuid())
  tenantId  String
  branchId  String?
  type      CertificateType
  name      String
  body      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  certificates Certificate[]

  @@index([tenantId])
}

/// A numbered, issued document — the issue register/log. `pdfUrl` stays null
/// until a real PDF pipeline exists (stub job, same posture as Unit 12's
/// Receipt/Unit 19's ReportCard). `issuedById` is a small addition beyond the
/// bare doc sketch (the issuer, needed for the register). Branch-owned —
/// RLS-scoped.
///
/// Unit 42 — `studentId` is now nullable and `staffId` added so a staff ID
/// card can be issued through the same register/numbering machinery instead
/// of a parallel `StaffCertificate` model. Exactly one of `studentId`/
/// `staffId` must be set — enforced at the app layer (service.ts), not a DB
/// constraint Postgres can express cleanly for an XOR across two nullable FKs.
model Certificate {
  id                   String          @id @default(cuid())
  tenantId             String
  branchId             String
  studentId            String?
  staffId              String?
  templateId           String?
  type                 CertificateType
  customTitle          String?
  number               String
  pdfUrl               String?
  issuedAt             DateTime        @default(now())
  issuedById           String
  signatureStatus      SignatureStatus @default(NONE)
  signatureRequestedAt DateTime?
  signedAt             DateTime?
  signedPdfUrl         String?

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  branch   Branch               @relation(fields: [branchId], references: [id])
  student  Student?             @relation(fields: [studentId], references: [id])
  staff    Staff?               @relation(fields: [staffId], references: [id])
  template CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@unique([branchId, type, number])
  @@index([tenantId])
}
