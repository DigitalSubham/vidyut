// Timetable — Unit 22. See context/data-model.md §11 and
// context/feature-specs/22-timetable.md. `dayOfWeek` is a plain Int 0-6
// (Monday=0 ... Sunday=6) — no enum needed, validated at the Zod layer.

/// One period slot in a section's weekly grid. Tenant-owned — RLS-scoped.
model TimetablePeriod {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  sessionId String
  sectionId String
  dayOfWeek Int
  periodNo  Int
  subjectId String
  staffId   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])
  section Section         @relation(fields: [sectionId], references: [id])
  subject Subject         @relation(fields: [subjectId], references: [id])
  staff   Staff           @relation(fields: [staffId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@unique([sectionId, dayOfWeek, periodNo])
  @@index([tenantId])
  substitutions Substitution[]
}

// Unit 47 — a same-day override for one recurring period; doesn't touch
// TimetablePeriod itself. `room` is null unless the substitution also moves
// rooms (defaults to the original period's room otherwise).
model Substitution {
  id                  String   @id @default(cuid())
  tenantId            String
  branchId            String
  timetablePeriodId   String
  date                DateTime @db.Date
  substituteStaffId   String
  room                String?
  reason              String?
  createdAt           DateTime @default(now())

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  branch           Branch          @relation(fields: [branchId], references: [id])
  timetablePeriod  TimetablePeriod @relation(fields: [timetablePeriodId], references: [id])
  substituteStaff  Staff           @relation(fields: [substituteStaffId], references: [id])

  @@unique([timetablePeriodId, date])
  @@index([tenantId])
  @@index([branchId, date])
}
